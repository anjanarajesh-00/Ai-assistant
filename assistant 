<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>My Personal AI</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0a0a0f;
    --surface: #12121a;
    --card: #1a1a28;
    --border: #2a2a40;
    --accent: #7c6ef5;
    --accent2: #f56e6e;
    --accent3: #6ef5c4;
    --text: #e8e8f0;
    --muted: #6a6a8a;
    --user-bubble: #1e1e35;
    --ai-bubble: #181826;
    --glow: rgba(124, 110, 245, 0.15);
  }

  body {
    font-family: 'Syne', sans-serif;
    background: var(--bg);
    color: var(--text);
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Animated background */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 20% 10%, rgba(124,110,245,0.08) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 80% 90%, rgba(110,245,196,0.06) 0%, transparent 60%),
      radial-gradient(ellipse 40% 60% at 90% 20%, rgba(245,110,110,0.05) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  /* HEADER */
  header {
    position: relative;
    z-index: 10;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    background: rgba(10,10,15,0.85);
    backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), var(--accent3));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
    box-shadow: 0 0 20px var(--glow);
    animation: pulse-glow 3s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 20px rgba(124,110,245,0.3); }
    50% { box-shadow: 0 0 35px rgba(124,110,245,0.6), 0 0 60px rgba(110,245,196,0.2); }
  }

  .header-info h1 {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -0.3px;
    background: linear-gradient(90deg, var(--text), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .header-info .status {
    font-size: 11px;
    color: var(--accent3);
    font-family: 'DM Mono', monospace;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent3);
    animation: blink 2s ease-in-out infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .header-actions {
    margin-left: auto;
    display: flex;
    gap: 8px;
  }

  .btn-icon {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 15px;
    transition: all 0.2s;
  }

  .btn-icon:hover { border-color: var(--accent); color: var(--accent); }

  /* SETUP PANEL */
  #setup-panel {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: fade-in 0.3s ease;
  }

  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }

  .setup-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 32px;
    max-width: 480px;
    width: 100%;
    box-shadow: 0 30px 80px rgba(0,0,0,0.5), 0 0 60px var(--glow);
    animation: slide-up 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes slide-up {
    from { opacity: 0; transform: translateY(30px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .setup-card .icon-big {
    font-size: 40px;
    margin-bottom: 16px;
    display: block;
  }

  .setup-card h2 {
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 8px;
    background: linear-gradient(135deg, var(--text), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .setup-card p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .setup-card a { color: var(--accent); }

  .field-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    display: block;
  }

  .setup-card input, .setup-card textarea {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    padding: 12px 14px;
    outline: none;
    transition: border-color 0.2s;
    margin-bottom: 16px;
  }

  .setup-card textarea { resize: vertical; min-height: 80px; font-family: 'Syne', sans-serif; font-size: 13px; }

  .setup-card input:focus, .setup-card textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--glow);
  }

  .btn-primary {
    width: 100%;
    padding: 13px;
    background: linear-gradient(135deg, var(--accent), #5a4fd4);
    border: none;
    border-radius: 10px;
    color: #fff;
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.3px;
  }

  .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 8px 25px rgba(124,110,245,0.4); }
  .btn-primary:active { transform: translateY(0); }

  /* CHAT AREA */
  #chat-area {
    flex: 1;
    overflow-y: auto;
    padding: 20px 16px;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #chat-area::-webkit-scrollbar { width: 4px; }
  #chat-area::-webkit-scrollbar-track { background: transparent; }
  #chat-area::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

  /* WELCOME */
  .welcome {
    text-align: center;
    padding: 40px 20px;
    animation: fade-in 0.6s ease;
  }

  .welcome .big-icon { font-size: 52px; margin-bottom: 16px; display: block; }

  .welcome h2 {
    font-size: 24px;
    font-weight: 800;
    background: linear-gradient(135deg, var(--text), var(--accent), var(--accent3));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
  }

  .welcome p { font-size: 14px; color: var(--muted); line-height: 1.6; max-width: 360px; margin: 0 auto 24px; }

  .suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }

  .suggestion-btn {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    color: var(--text);
    font-family: 'Syne', sans-serif;
    font-size: 12px;
    padding: 8px 14px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
  }

  .suggestion-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  /* MESSAGES */
  .message {
    display: flex;
    gap: 10px;
    animation: msg-in 0.3s cubic-bezier(0.34, 1.2, 0.64, 1);
    max-width: 100%;
  }

  @keyframes msg-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .message.user { flex-direction: row-reverse; }

  .msg-avatar {
    width: 30px;
    height: 30px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .message.ai .msg-avatar {
    background: linear-gradient(135deg, var(--accent), var(--accent3));
  }

  .message.user .msg-avatar {
    background: var(--card);
    border: 1px solid var(--border);
  }

  .bubble {
    max-width: calc(100% - 50px);
    padding: 12px 15px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.65;
  }

  .message.ai .bubble {
    background: var(--ai-bubble);
    border: 1px solid var(--border);
    border-radius: 4px 16px 16px 16px;
    color: var(--text);
  }

  .message.user .bubble {
    background: var(--user-bubble);
    border: 1px solid rgba(124,110,245,0.3);
    border-radius: 16px 4px 16px 16px;
    color: var(--text);
  }

  .bubble pre {
    background: rgba(0,0,0,0.4);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px;
    overflow-x: auto;
    margin: 8px 0;
    font-family: 'DM Mono', monospace;
    font-size: 12px;
  }

  .bubble code {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    background: rgba(124,110,245,0.15);
    padding: 2px 5px;
    border-radius: 4px;
    color: var(--accent3);
  }

  .bubble pre code { background: none; padding: 0; }

  .bubble strong { color: var(--accent3); font-weight: 700; }

  /* TYPING INDICATOR */
  .typing-indicator {
    display: flex;
    gap: 4px;
    align-items: center;
    padding: 14px 16px;
  }

  .typing-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    animation: typing 1.2s ease-in-out infinite;
  }

  .typing-dot:nth-child(2) { animation-delay: 0.2s; background: var(--accent3); }
  .typing-dot:nth-child(3) { animation-delay: 0.4s; background: var(--accent2); }

  @keyframes typing {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-6px); opacity: 1; }
  }

  /* INPUT AREA */
  #input-area {
    position: relative;
    z-index: 10;
    padding: 12px 16px 16px;
    border-top: 1px solid var(--border);
    background: rgba(10,10,15,0.9);
    backdrop-filter: blur(20px);
  }

  .input-box {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 10px 10px 10px 16px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .input-box:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--glow);
  }

  #user-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    color: var(--text);
    font-family: 'Syne', sans-serif;
    font-size: 14px;
    resize: none;
    max-height: 140px;
    min-height: 24px;
    line-height: 1.5;
    padding: 2px 0;
  }

  #user-input::placeholder { color: var(--muted); }

  #send-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: none;
    background: linear-gradient(135deg, var(--accent), #5a4fd4);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s;
    font-size: 16px;
  }

  #send-btn:hover { transform: scale(1.08); box-shadow: 0 4px 15px rgba(124,110,245,0.5); }
  #send-btn:disabled { opacity: 0.4; transform: none; cursor: not-allowed; }

  .input-hint {
    font-size: 10px;
    color: var(--muted);
    text-align: center;
    margin-top: 8px;
    font-family: 'DM Mono', monospace;
  }

  /* Error */
  .error-msg {
    background: rgba(245,110,110,0.1);
    border: 1px solid rgba(245,110,110,0.3);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    color: var(--accent2);
    margin: 4px 0;
  }

  /* NAME tag */
  .ai-name-tag {
    font-size: 10px;
    font-weight: 700;
    color: var(--accent);
    font-family: 'DM Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .msg-col { display: flex; flex-direction: column; max-width: calc(100% - 40px); }
</style>
</head>
<body>

<!-- SETUP PANEL -->
<div id="setup-panel">
  <div class="setup-card">
    <span class="icon-big">🤖</span>
    <h2>Build Your Personal AI</h2>
    <p>
      Enter your Anthropic API key and give your AI a name & personality.
      Get your free API key at <a href="https://console.anthropic.com" target="_blank">console.anthropic.com</a>
    </p>

    <label class="field-label">Your Anthropic API Key</label>
    <input type="password" id="api-key-input" placeholder="sk-ant-api03-..." />

    <label class="field-label">Name Your AI</label>
    <input type="text" id="ai-name-input" placeholder="e.g. Aria, Max, Spark..." value="Aria" />

    <label class="field-label">Give it a Personality (optional)</label>
    <textarea id="personality-input" placeholder="e.g. You are a helpful coding assistant who loves making apps and always explains things simply...">You are a brilliant, friendly personal AI assistant. You help with app making, coding, design ideas, writing, and anything the user needs. You're enthusiastic, creative, and always give clear, actionable answers. You talk like a smart friend, not a robot.</textarea>

    <button class="btn-primary" onclick="startChat()">🚀 Launch My AI</button>
  </div>
</div>

<!-- HEADER -->
<header>
  <div class="avatar" id="header-avatar">✨</div>
  <div class="header-info">
    <h1 id="header-name">My Personal AI</h1>
    <div class="status"><span class="status-dot"></span><span>Ready to help</span></div>
  </div>
  <div class="header-actions">
    <button class="btn-icon" onclick="clearChat()" title="Clear chat">🗑️</button>
    <button class="btn-icon" onclick="showSetup()" title="Settings">⚙️</button>
  </div>
</header>

<!-- CHAT -->
<div id="chat-area">
  <div class="welcome" id="welcome-screen">
    <span class="big-icon">✨</span>
    <h2 id="welcome-title">Hi! I'm Your AI</h2>
    <p id="welcome-sub">I'm here to help you build apps, write code, brainstorm ideas, or anything you need. What shall we create today?</p>
    <div class="suggestions">
      <button class="suggestion-btn" onclick="sendSuggestion(this)">🛠️ Help me build an app</button>
      <button class="suggestion-btn" onclick="sendSuggestion(this)">💡 Brainstorm ideas with me</button>
      <button class="suggestion-btn" onclick="sendSuggestion(this)">✍️ Write something for me</button>
      <button class="suggestion-btn" onclick="sendSuggestion(this)">🐛 Debug my code</button>
      <button class="suggestion-btn" onclick="sendSuggestion(this)">🎨 Design help</button>
    </div>
  </div>
</div>

<!-- INPUT -->
<div id="input-area">
  <div class="input-box">
    <textarea id="user-input" placeholder="Ask me anything..." rows="1"></textarea>
    <button id="send-btn" onclick="sendMessage()">➤</button>
  </div>
  <div class="input-hint">Press Enter to send · Shift+Enter for new line</div>
</div>

<script>
  let apiKey = '';
  let aiName = 'Aria';
  let systemPrompt = '';
  let conversationHistory = [];
  let isTyping = false;

  const chatArea = document.getElementById('chat-area');
  const userInput = document.getElementById('user-input');
  const sendBtn = document.getElementById('send-btn');

  // Auto-resize textarea
  userInput.addEventListener('input', () => {
    userInput.style.height = 'auto';
    userInput.style.height = Math.min(userInput.scrollHeight, 140) + 'px';
  });

  userInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  function startChat() {
    const keyVal = document.getElementById('api-key-input').value.trim();
    const nameVal = document.getElementById('ai-name-input').value.trim() || 'Aria';
    const personalityVal = document.getElementById('personality-input').value.trim();

    if (!keyVal) {
      alert('Please enter your Anthropic API key!');
      return;
    }

    apiKey = keyVal;
    aiName = nameVal;
    systemPrompt = personalityVal || `You are ${aiName}, a brilliant personal AI assistant. Help with anything the user needs.`;

    // Update UI
    document.getElementById('header-name').textContent = aiName;
    document.getElementById('welcome-title').textContent = `Hi! I'm ${aiName} ✨`;
    document.getElementById('welcome-sub').textContent = `I'm your personal AI — here to help you build apps, write code, brainstorm ideas, or anything you need. What shall we create today?`;

    document.getElementById('setup-panel').style.display = 'none';
    conversationHistory = [];
    userInput.focus();
  }

  function showSetup() {
    document.getElementById('setup-panel').style.display = 'flex';
  }

  function sendSuggestion(btn) {
    const text = btn.textContent.replace(/^[^\w]+/, '').trim();
    userInput.value = text;
    sendMessage();
  }

  function clearChat() {
    conversationHistory = [];
    const welcome = document.getElementById('welcome-screen');
    chatArea.innerHTML = '';
    chatArea.appendChild(welcome);
    welcome.style.display = '';
  }

  function hideWelcome() {
    const w = document.getElementById('welcome-screen');
    if (w) w.style.display = 'none';
  }

  function addMessage(role, content) {
    hideWelcome();

    const msg = document.createElement('div');
    msg.className = `message ${role}`;

    const avatarEl = document.createElement('div');
    avatarEl.className = 'msg-avatar';
    avatarEl.textContent = role === 'ai' ? '✨' : '👤';

    const col = document.createElement('div');
    col.className = 'msg-col';

    if (role === 'ai') {
      const nameTag = document.createElement('div');
      nameTag.className = 'ai-name-tag';
      nameTag.textContent = aiName;
      col.appendChild(nameTag);
    }

    const bubble = document.createElement('div');
    bubble.className = 'bubble';
    bubble.innerHTML = formatMessage(content);

    col.appendChild(bubble);
    msg.appendChild(avatarEl);
    msg.appendChild(col);
    chatArea.appendChild(msg);
    chatArea.scrollTop = chatArea.scrollHeight;

    return bubble;
  }

  function formatMessage(text) {
    // Code blocks
    text = text.replace(/```(\w*)\n?([\s\S]*?)```/g, (_, lang, code) =>
      `<pre><code>${escapeHtml(code.trim())}</code></pre>`
    );
    // Inline code
    text = text.replace(/`([^`]+)`/g, '<code>$1</code>');
    // Bold
    text = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    // Newlines
    text = text.replace(/\n/g, '<br>');
    return text;
  }

  function escapeHtml(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function showTyping() {
    hideWelcome();
    const msg = document.createElement('div');
    msg.className = 'message ai';
    msg.id = 'typing-msg';

    const avatarEl = document.createElement('div');
    avatarEl.className = 'msg-avatar';
    avatarEl.textContent = '✨';

    const col = document.createElement('div');
    col.className = 'msg-col';

    const nameTag = document.createElement('div');
    nameTag.className = 'ai-name-tag';
    nameTag.textContent = aiName;

    const bubble = document.createElement('div');
    bubble.className = 'bubble';
    bubble.innerHTML = '<div class="typing-indicator"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div>';

    col.appendChild(nameTag);
    col.appendChild(bubble);
    msg.appendChild(avatarEl);
    msg.appendChild(col);
    chatArea.appendChild(msg);
    chatArea.scrollTop = chatArea.scrollHeight;
  }

  function removeTyping() {
    const t = document.getElementById('typing-msg');
    if (t) t.remove();
  }

  async function sendMessage() {
    if (isTyping) return;

    const text = userInput.value.trim();
    if (!text) return;

    if (!apiKey) {
      showSetup();
      return;
    }

    // Add user message
    addMessage('user', text);
    conversationHistory.push({ role: 'user', content: text });

    userInput.value = '';
    userInput.style.height = 'auto';
    sendBtn.disabled = true;
    isTyping = true;
    showTyping();

    try {
      const response = await fetch('https://api.anthropic.com